# Public HTTP / HTTPS URLs
VITE_SITE_URL=https://masonkliu.github.io
VITE_DEV_URL=http://127.0.0.1:5173
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_BASE_PATH=/

# Site Identity & Defaults
VITE_SITE_TITLE=Mason Liu | Systems Architect & Full-Stack Engineer
VITE_SITE_TAGLINE=Digital Architecture & Systems Engineering Scroll
VITE_AUTHOR_NAME=Mason Liu
VITE_AUTHOR_HANDLE=MasonKLiu
VITE_DEFAULT_LANG=zh
VITE_CONTACT_EMAIL=theworldstructure@gmail.com

# External Repository & Profile Endpoints
VITE_GITHUB_PROFILE_URL=https://github.com/MasonKLiu
